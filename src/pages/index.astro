---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const notes = await getCollection("notes");
---

<BaseLayout title="hello">
   <h1>Astro</h1>
   <h2>Notes</h2>
   <ul>
      {notes.map(note => (
            <li><a href={`/notes/${note.id}`}>{note.data.title}</a></li>
         ))}
   </ul>
</BaseLayout>
